<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             targetNamespace="http://example.com">
  <process id="service-task-process" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="sf1" sourceRef="start" targetRef="call-api"/>
    <serviceTask id="call-api" name="Call API">
    </serviceTask>
    <sequenceFlow id="sf2" sourceRef="call-api" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
